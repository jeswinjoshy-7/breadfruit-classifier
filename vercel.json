{
  "framework": "python",
  "functions": {
    "api": {
      "runtime": "python3.13",
      "entrypoint": "python app.py",
      "port": 8000
    }
  },
  "routes": [
    {
      "src": "/api/predict/(.*)",
      "dest": "http://127.0.0.1:8000/predict/$1"
    },
    {
      "src": "/api/health",
      "dest": "http://127.0.0.1:8000/health"
    },
    {
      "src": "/api/gradcam/info",
      "dest": "http://127.0.0.1:8000/gradcam/info"
    },
    {
      "src": "/(.*)",
      "dest": "streamlit_app/app.py"
    }
  ]
}